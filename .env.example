# NEVER commit real secrets. Copy to .env and fill locally.
# Supabase (from project settings)
SUPABASE_URL=http://localhost:8010
SUPABASE_ANON_KEY=paste-anon-key
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-only-in-backend-env
# Postgres: pooler for ORM traffic, DIRECT/session-mode for LangGraph checkpointer
DATABASE_URL_POOLER=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DATABASE_URL_DIRECT=postgresql+psycopg://postgres:postgres@localhost:54322/postgres
# LLM router: chain Groq -> Ollama -> OpenRouter (first success wins).
# Per-call budget (seconds) caps total chain time. See app/core/llm.py.
# Per-task model tiering: {PROVIDER}_MODEL_FAST for short/structured tasks
# (extract, jd, explain, validate, coach); {PROVIDER}_MODEL for heavy tasks
# (plan, optimize, interview).
LLM_PRIMARY=groq
LLM_FALLBACKS=ollama,openrouter
LLM_CALL_BUDGET=55
OPENROUTER_API_KEY=paste-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
# ATS semantic match (all-MiniLM-L6-v2). 1 enables the 20% semantic component;
# 0 drops it and renormalizes the remaining weights. Warmed at boot.
CAREERPILOT_SEMANTIC=1
GEMINI_API_KEY=optional
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=careerpilot
GROQ_API_KEY=optional
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# NVIDIA NIM (OpenAI-compatible). Route a single agent to it while the rest
# stay on the main chain; any error falls back to LLM_PRIMARY/LLM_FALLBACKS.
NVIDIA_API_KEY=paste-nvidia-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# One agent can be pinned to NVIDIA first (falls back to the chain on error):
#   LLM_TASK_PROVIDERS=interview=nvidia
# Only enable a model your NIM account actually serves (many are 404/EOL);
# verify with: GET https://integrate.api.nvidia.com/v1/models
LLM_TASK_PROVIDERS=
# Jobs (v1 = Adzuna only; JSearch P2)
# CAREERPILOT_JOBS=0 disables job discovery + matching entirely (default).
# Deterministic + LLM-free; set to 1 to run the node again.
CAREERPILOT_JOBS=0
ADZUNA_APP_ID=paste-id
ADZUNA_APP_KEY=paste-key
JSEARCH_API_KEY=optional-p2
# Observability (free-tier availability)
LANGSMITH_API_KEY=optional
SENTRY_DSN=optional
# App
BACKEND_URL=http://localhost:8010
FRONTEND_URL=http://localhost:3001
SSE_STREAM_TOKEN_TTL_MIN=5

# Demo auth user that owns history rows until Supabase JWT auth lands.
# Create: python -m scripts.create_demo_user (from backend/)
DEMO_USER_ID=
